# DreamCraft — local development env example.
# Copy to .env.local and edit. .env.local is gitignored.

# ── LLM (Qwen via LM Studio or Ollama) ───────────────────────────────
QWEN_BASE_URL=http://localhost:1234
QWEN_MODEL=qwen3-coder-30b-a3b-instruct-mlx

# ── Stable Diffusion (Automatic1111 WebUI) ───────────────────────────
SD_BASE_URL=http://127.0.0.1:7860

# ── Hosted image generation fallback (recommended for AlemPlus) ──────
# Use fal.ai FLUX when local Stable Diffusion is not available.
SD_BACKEND=fal
FAL_API_KEY=
FAL_MODEL=fal-ai/flux/schnell

# ── Narrator voice (optional; falls back to no-tts when empty) ────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── TRELLIS (image → 3D GLB) ─────────────────────────────────────────
# Either an HF Space id (default) OR a local Gradio URL like http://127.0.0.1:7861
TRELLIS_URL=JeffreyXiang/TRELLIS-image-large
# Required when TRELLIS_URL is an HF Space. Get a token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Client-side knobs (NEXT_PUBLIC_*) ────────────────────────────────
# Hard timeout for /loading-dream before forcing navigation to /play.
NEXT_PUBLIC_MAX_GENERATION_MS=75000
# Set to "1" to skip all AI calls and navigate to /play with a fallback
# config after 3s. Useful for testing the 3D scene without LM Studio / SD / TRELLIS.
NEXT_PUBLIC_DEV_FAKE_AI=0

# ── Optional flags ───────────────────────────────────────────────────
# TRELLIS HF Spaces are unstable. Keep disabled until upstream is healthy.
TRELLIS_ENABLED=0

# Set to "1" to make /api/generate-3d also write GLBs into ../godot/assets/
WRITE_GODOT_ASSETS=0
